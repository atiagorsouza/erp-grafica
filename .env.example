# =============================================================================
# PrintFlow ERP · Variáveis de ambiente
# Copie para .env e ajuste os valores antes de instalar:
#   cp .env.example .env
# =============================================================================

# PostgreSQL (obrigatório)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Servidor HTTP (opcional — usados por scripts/start.sh)
PORT=3000
HOSTNAME=0.0.0.0

# Ambiente Node
NODE_ENV=production

# API pública do portal — nome:chave separados por vírgula (mín. 24 chars)
# Gere com: openssl rand -base64 32 | tr -d "/+=" | head -c 40
PORTAL_API_KEYS="portal:TROQUE_POR_UMA_CHAVE_LONGA_E_ALEATORIA"

# Backup automático: caminho para cópia FORA deste servidor
# (pendrive montado, HD externo, pasta de rede). Sem isto, o backup
# fica no mesmo disco do banco — e não protege contra o disco falhar.
# BACKUP_EXTERNO="/mnt/backup-printflow"
