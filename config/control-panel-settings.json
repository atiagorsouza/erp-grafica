        },
        {
          "key": "prazo_horario_corte",
          "label": "Horário de corte",
          "type": "text",
          "defaultValue": "17:00",
          "mono": true,
          "hint": "Pedido aprovado depois deste horário conta a partir do dia seguinte. Evita prometer o que não dá para começar hoje."
