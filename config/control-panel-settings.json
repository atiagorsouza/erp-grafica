    {
      "id": "tributacao",
      "title": "Precificação & taxas",
      "desc": "Parâmetros globais usados pelo motor de preços em todos os cálculos.",
      "icon": "calc",
      "color": "text-amber-600",
      "fields": [
        {
          "key": "tax_rate",
          "label": "Imposto sobre venda (Simples etc.)",
          "type": "number",
          "suffix": "%",
          "hint": "Embutido no preço final pelo motor",
          "defaultValue": "6"
        },
        {
          "key": "operational_rate",
          "label": "Markup operacional (aluguel, folha, energia)",
          "type": "number",
          "suffix": "%",
          "defaultValue": "15"
        },
        {
          "key": "labor_hourly_rate",
          "label": "Valor da hora de mão de obra",
          "type": "number",
          "prefix": "R$",
          "hint": "Multiplica as \"Horas estimadas\" do serviço e entra como custo. Deixe 0 para não cobrar por hora.",
          "defaultValue": "0"
        },
        {
          "key": "card_fee_debit",
          "label": "Taxa maquininha — Débito",
          "type": "number",
          "suffix": "%",
          "mono": true,
          "defaultValue": "1.99"
        },
        {
          "key": "card_fee_credit",
          "label": "Taxa maquininha — Crédito",
          "type": "number",
          "suffix": "%",
          "mono": true,
          "defaultValue": "4.99"
        },
        {
          "key": "pricing_payment_cost",
          "label": "Custo de pagamento embutido no preço",
          "type": "number",
          "suffix": "%",
          "mono": true,
          "hint": "Pior meio que você aceita (ex.: 3x sem juros = 6,12%). Garante a margem mínima em qualquer forma de pagamento.",
          "defaultValue": "6.12"
        },
        {
          "key": "pricing_pix_discount",
          "label": "Desconto à vista no PIX",
          "type": "number",
          "suffix": "%",
          "mono": true,
          "hint": "Desconto da política da empresa para pagamento à vista com cadastro em dia. NÃO confundir com a taxa do cartão: o padrão antigo (6,12%) era o custo da maquininha e dava mais desconto do que se pretendia.",
          "defaultValue": "5"
        },
        {
          "key": "pricing_installment_min",
          "label": "Valor mínimo para parcelar sem juros",
          "type": "number",
          "prefix": "R$",
          "mono": true,
          "hint": "Abaixo disso o PDV não oferece 3x — parcela pequena demais compensa pouco.",
          "defaultValue": "150"
        },
        {
          "key": "pricing_installment_max",
          "label": "Máximo de parcelas sem juros",
          "type": "number",
          "suffix": "x",
          "mono": true,
          "defaultValue": "3"
        },
        {
          "key": "pricing_min_margin",
          "label": "Margem mínima (piso)",
          "type": "number",
          "suffix": "%",
          "mono": true,
          "hint": "O sistema avisa se um desconto derrubar a margem abaixo deste valor.",
          "defaultValue": "40"
        }
      ]
    },
    {
      "id": "documentos",
      "title": "Numeração de documentos",
