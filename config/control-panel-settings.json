    {
      "id": "prazos",
      "title": "Prazos & Expediente",
      "desc": "Quando a gráfica PRODUZ e quando ATENDE — são coisas diferentes. Usado para calcular a data de entrega prometida no orçamento e no pedido.",
      "icon": "clock",
      "color": "text-proc-c",
