        {
          "key": "document_prefix_order",
          "label": "Prefixo pedido / OS",
          "mono": true,
          "hint": "Ex.: PED",
          "defaultValue": "PED"
        },
        {
          "key": "document_prefix_sale",
          "label": "Prefixo venda PDV",
          "mono": true,
          "hint": "Ex.: PDV",
          "defaultValue": "PDV"
        },
        {
          "key": "document_prefix_purchase",
          "label": "Prefixo compra",
          "mono": true,
          "hint": "Ex.: CMP",
          "defaultValue": "CMP"
        }
      ]
    },
